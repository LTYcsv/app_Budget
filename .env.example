# Copy to .env and fill in real values before running docker compose
# Generate JWT_SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"

# APP_ENV=development relaxes some safety checks (allows the built-in default
# JWT secret for local runs). Anything else is treated as production.
APP_ENV=development
DB_USER=postgres
DB_PASSWORD=change_me_in_production
JWT_SECRET_KEY=change_me_in_production_min_32_chars
COOKIE_SECURE=false   # set to true only in production with HTTPS
